+// PRISM_LOCAL_PATCH (see Prism/Vendor/projectm-VERSION.md): lets the host app read the currently
+// running preset transition's state (if any), so it can apply the same transition - same effect,
+// same timing, same random parameters - to content it composites outside of projectM's own
+// renderer (e.g. Prism's album art overlay) instead of guessing independently.
+auto ProjectM::IsPresetTransitionActive() const -> bool
+{
+    return m_transition != nullptr && m_transitioningPreset != nullptr;
+}
+
+auto ProjectM::PresetTransitionProgress() const -> double
+{
+    if (!m_transition)
+    {
+        return 0.0;
+    }
+    return m_transition->Progress(m_timeKeeper->GetFrameTime());
+}
+
+auto ProjectM::PresetTransitionShaderIndex() const -> int
+{
+    return m_transition ? m_transition->ShaderIndex() : -1;
+}
+
+auto ProjectM::PresetTransitionRandomValues() const -> std::array<int, 4>
+{
+    if (!m_transition)
+    {
+        return {0, 0, 0, 0};
+    }
+    auto values = m_transition->StaticRandomValues();
+    return {values.x, values.y, values.z, values.w};
+}
