    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prism needs permission to see what track is currently playing."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج موشور إلى إذن لمعرفة المقطع الموسيقي الذي يتم تشغيله حاليًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisme skal bruge tilladelse til at se, hvilket nummer der afspilles i øjeblikket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisma benötigt die Berechtigung, um zu sehen, welcher Titel gerade abgespielt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisma necesita permiso para ver qué canción se está reproduciendo actualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisme a besoin d'une autorisation pour voir quel morceau est en cours de lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान में कौन सा ट्रैक चल रहा है, यह देखने के लिए प्रिज़्म को अनुमति की आवश्यकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisma necessita dell'autorizzazione per vedere quale brano è attualmente in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリズムは、現在再生中の曲を確認するために許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리즘이 현재 재생 중인 트랙을 확인하려면 권한이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisme trenger tillatelse for å se hvilket spor som spilles av nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisma heeft toestemming nodig om te zien welk nummer er momenteel wordt afgespeeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Prisma precisa de permissão para ver qual faixa está tocando no momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению «Призма» нужно разрешение, чтобы видеть, какой трек сейчас воспроизводится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisma behöver behörighet för att se vilket spår som spelas upp för närvarande."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "棱镜需要权限才能查看当前正在播放的曲目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稜鏡需要權限才能查看目前正在播放的曲目。"
          }
        }
      }
    },
