    "In Music, choose Window > Visualizer Settings > Prism to select it, then Window > Visualizer (⌘T)." : {
      "comment" : "A description of how to install the Apple Music/iTunes Visualizer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في تطبيق الموسيقى، اختر نافذة > إعدادات أداة التصور > موشور لتحديدها، ثم نافذة > أداة التصور (⌘T)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Musik skal du vælge Vindue > Visualiseringsindstillinger > Prisme for at vælge det, derefter Vindue > Visualisering (⌘T)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in Musik „Fenster“ > „Visualizer-Einstellungen“ > „Prisma“ aus, dann „Fenster“ > „Visualizer“ (⌘T)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Música, elige Ventana > Ajustes del visualizador > Prisma para seleccionarlo y, después, Ventana > Visualizador (⌘T)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Musique, choisissez Fenêtre > Réglages du visualiseur > Prisme pour le sélectionner, puis Fenêtre > Visualiseur (⌘T)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music में, Window > Visualizer Settings > प्रिज़्म चुनें, फिर Window > Visualizer (⌘T) चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Musica, scegli Finestra > Impostazioni Visualizzatore > Prisma per selezionarlo, poi Finestra > Visualizzatore (⌘T)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージック App で、「ウインドウ」>「ビジュアライザ設定」>「プリズム」を選択し、次に「ウインドウ」>「ビジュアライザ」(⌘T) を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뮤직 앱에서 윈도우 > 비주얼라이저 설정 > 프리즘을 선택한 다음, 윈도우 > 비주얼라이저(⌘T)를 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Musikk velger du Vindu > Visualiseringsinnstillinger > Prisme for å velge det, deretter Vindu > Visualisering (⌘T)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies in Muziek Venster > Visualizer-instellingen > Prisma om het te selecteren, kies vervolgens Venster > Visualizer (⌘T)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Música, escolha Janela > Ajustes do Visualizador > Prisma para selecioná-lo e, em seguida, Janela > Visualizador (⌘T)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В приложении «Музыка» выберите «Окно» > «Настройки визуализатора» > Призма, затем «Окно» > «Визуализатор» (⌘T)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Musik väljer du Fönster > Visualiserarinställningar > Prisma för att välja det, sedan Fönster > Visualiserare (⌘T)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“音乐”App 中，选择“窗口” >“可视化插件设置” >“棱镜”，然后选择“窗口” >“可视化插件”（⌘T）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「音樂」App 中，選擇「視窗」>「視覺化外掛設定」>「稜鏡」以選取它，然後選擇「視窗」>「視覺化效果」(⌘T)。"
          }
        }
      }
    },
    "Install Prism as a screen saver, then enable it via System Settings > Wallpaper > Screen Saver... > Other > Prism." : {
      "comment" : "A description of how to install Prism as a screen saver.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت موشور كشاشة توقف، ثم فعّله عبر إعدادات النظام > الخلفية > شاشة التوقف... > أخرى > موشور."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer Prisme som pauseskærm, og aktivér den derefter via Systemindstillinger > Baggrund > Pauseskærm... > Andet > Prisme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere Prisma als Bildschirmschoner und aktiviere es dann über „Systemeinstellungen“ > „Hintergrund“ > „Bildschirmschoner…“ > „Andere“ > „Prisma“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala Prisma como salvapantallas y actívalo desde Ajustes del Sistema > Fondo de pantalla > Salvapantallas... > Otro > Prisma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez Prisme comme économiseur d'écran, puis activez-le via Réglages Système > Fond d'écran > Économiseur d'écran... > Autre > Prisme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रिज़्म को स्क्रीन सेवर के रूप में इंस्टॉल करें, फिर इसे सिस्टम सेटिंग्स > वॉलपेपर > स्क्रीन सेवर... > अन्य > प्रिज़्म से सक्षम करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa Prisma come salvaschermo, poi attivalo da Impostazioni di Sistema > Sfondo > Salvaschermo... > Altro > Prisma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリズムをスクリーンセーバーとしてインストールし、「システム設定」>「壁紙」>「スクリーンセーバ」>「その他」>「プリズム」から有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리즘을 스크린 세이버로 설치한 다음 시스템 설정 > 배경화면 > 스크린 세이버... > 기타 > 프리즘에서 활성화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer Prisme som skjermsparer, og aktiver den deretter via Systeminnstillinger > Bakgrunn > Skjermsparer... > Annet > Prisme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer Prisma als schermbeveiliging en schakel deze vervolgens in via Systeeminstellingen > Bureaubladachtergrond > Schermbeveiliging... > Overige > Prisma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o Prisma como protetor de tela e ative-o em Ajustes do Sistema > Papel de Parede > Protetor de Tela... > Outro > Prisma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите Призма в качестве заставки, затем включите её через «Системные настройки» > «Обои» > «Заставка…» > «Другие» > Призма."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installera Prisma som skärmsläckare och aktivera den sedan via Systeminställningar > Bakgrund > Skärmsläckare... > Övriga > Prisma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将棱镜安装为屏幕保护程序，然后通过“系统设置” >“壁纸” >“屏幕保护程序” >“其他” >“棱镜”启用它。"
          }
        },
        "zh-Hant" : {
